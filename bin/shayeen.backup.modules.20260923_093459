#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"

while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    LINK="$(readlink "$SOURCE")"

    case "$LINK" in
        /*)
            SOURCE="$LINK"
            ;;
        *)
            SOURCE="$DIR/$LINK"
            ;;
    esac
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

source "$BASE_DIR/core/config.sh"
source "$BASE_DIR/core/ui.sh"
source "$BASE_DIR/core/environment.sh"
source "$BASE_DIR/core/logger.sh"

for module in \
    network/network \
    security/security \
    system/system \
    crypto/crypto \
    download/download \
    files/files \
    search/search \
    monitor/monitor \
    developer/developer \
    storage/storage \
    utilities/utilities \
    settings/settings
do
    [ -f "$BASE_DIR/modules/$module.sh" ] &&
        source "$BASE_DIR/modules/$module.sh"
done

build_project() {
    title "SHΛYEN / BUILD ENGINE"

    dev_detect

    printf '\n%sBuild operations are project-specific.%s\n' "$DIM" "$RESET"

    if [ -f "package.json" ]; then
        command -v npm >/dev/null 2>&1 || {
            warn "npm is not installed."
            return 1
        }

        printf 'Detected Node.js project.\n'
        printf 'Run npm test/build? [y/N] '
        read -r answer

        case "$answer" in
            y|Y)
                npm test 2>/dev/null || true
                npm run build
                ;;
            *) warn "Build cancelled." ;;
        esac

    elif [ -f "Cargo.toml" ]; then
        command -v cargo >/dev/null 2>&1 || return 1
        cargo test
        cargo build --release

    elif [ -f "go.mod" ]; then
        command -v go >/dev/null 2>&1 || return 1
        go test ./...
        go build ./...

    elif [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
        command -v python >/dev/null 2>&1 || return 1
        python -m compileall .

    elif [ -f "Makefile" ]; then
        command -v make >/dev/null 2>&1 || return 1
        make

    elif [ -f "settings.gradle" ] || [ -f "settings.gradle.kts" ]; then
        if command -v ./gradlew >/dev/null 2>&1; then
            ./gradlew test
        elif [ -x "./gradlew" ]; then
            ./gradlew test
        else
            warn "Gradle wrapper not found."
        fi

    else
        warn "No supported build system detected."
    fi
}

show_system_menu() {
    while true; do
        header
        section "SYSTEM"
        printf '  1) info\n'
        printf '  2) cpu\n'
        printf '  3) memory\n'
        printf '  4) storage\n'
        printf '  5) processes\n'
        printf '  6) packages\n'
        printf '  7) environment\n'
        printf '  8) diagnose\n'
        printf '  0) back\n\n'
        prompt
        read -r choice

        case "$choice" in
            1) system_info ;;
            2) system_cpu ;;
            3) system_memory ;;
            4) system_storage ;;
            5) system_processes ;;
            6) system_packages ;;
            7) system_environment ;;
            8) system_diagnose ;;
            0) return ;;
            *) warn "Invalid option." ;;
        esac
        pause
    done
}

show_network_menu() {
    while true; do
        header
        section "NETWORK"
        printf '  1) interfaces     2) routes\n'
        printf '  3) dns            4) connectivity\n'
        printf '  5) public-ip      6) ports\n'
        printf '  7) diagnostics    0) back\n\n'
        prompt
        read -r choice

        case "$choice" in
            1) network_interfaces ;;
            2) network_routes ;;
            3) network_dns ;;
            4) network_connectivity ;;
            5) network_public_ip ;;
            6) network_ports ;;
            7) network_diagnostics ;;
            0) return ;;
            *) warn "Invalid option." ;;
        esac
        pause
    done
}

show_security_menu() {
    while true; do
        header
        section "SECURITY"
        printf '  1) audit          2) permissions\n'
        printf '  3) hashes         4) certificates\n'
        printf '  5) files          6) environment\n'
        printf '  7) report         0) back\n\n'
        prompt
        read -r choice

        case "$choice" in
            1) security_audit ;;
            2) security_permissions "$HOME" ;;
            3) security_hashes ;;
            4) security_certificates ;;
            5) security_files ;;
            6) security_environment ;;
            7) security_report ;;
            0) return ;;
            *) warn "Invalid option." ;;
        esac
        pause
    done
}

show_crypto_menu() {
    while true; do
        header
        section "CRYPTO"
        printf '  1) hash           2) sha256\n'
        printf '  3) sha512         4) checksum\n'
        printf '  5) encrypt        6) decrypt\n'
        printf '  7) keygen         8) sign\n'
        printf '  9) verify         0) back\n\n'
        prompt
        read -r choice

        case "$choice" in
            1) read -rp "File: " f; crypto_hash "$f" ;;
            2) read -rp "File: " f; crypto_sha256 "$f" ;;
            3) read -rp "File: " f; crypto_sha512 "$f" ;;
            4) read -rp "File: " f; crypto_checksum "$f" ;;
            5) read -rp "File: " f; crypto_encrypt "$f" ;;
            6) read -rp "File: " f; crypto_decrypt "$f" ;;
            7) crypto_keygen ;;
            8) read -rp "File: " f; crypto_sign "$f" ;;
            9) read -rp "Signature: " s; read -rp "File: " f; crypto_verify "$s" "$f" ;;
            0) return ;;
            *) warn "Invalid option." ;;
        esac
        pause
    done
}

show_files_menu() {
    while true; do
        header
        section "FILES"
        printf '  1) search         2) copy\n'
        printf '  3) move           4) rename\n'
        printf '  5) delete         6) compress\n'
        printf '  7) extract        8) checksum\n'
        printf '  9) permissions    0) back\n\n'
        prompt
        read -r choice

        case "$choice" in
            1) read -rp "Pattern: " p; files_search "$p" ;;
            2) read -rp "Source: " a; read -rp "Destination: " b; files_copy "$a" "$b" ;;
            3) read -rp "Source: " a; read -rp "Destination: " b; files_move "$a" "$b" ;;
            4) read -rp "Old: " a; read -rp "New: " b; files_rename "$a" "$b" ;;
            5) read -rp "Target: " a; files_delete "$a" ;;
            6) read -rp "Source: " a; files_compress "$a" ;;
            7) read -rp "Archive: " a; files_extract "$a" ;;
            8) read -rp "File: " a; files_checksum "$a" ;;
            9) read -rp "Path: " a; files_permissions "$a" ;;
            0) return ;;
            *) warn "Invalid option." ;;
        esac
        pause
    done
}

show_dashboard() {
    while true; do
        header

        printf '\n'
        printf '%s┌────────────────────┬────────────────────┬────────────────────┐%s\n' "$BRIGHT_BLACK" "$RESET"
        printf '%s│%s [01] SYSTEM       %s│%s [02] NETWORK      %s│%s [03] SECURITY     %s│%s\n' "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$RESET"
        printf '%s├────────────────────┼────────────────────┼────────────────────┤%s\n' "$BRIGHT_BLACK" "$RESET"
        printf '%s│%s [04] CRYPTO       %s│%s [05] DOWNLOAD     %s│%s [06] FILES        %s│%s\n' "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$RESET"
        printf '%s├────────────────────┼────────────────────┼────────────────────┤%s\n' "$BRIGHT_BLACK" "$RESET"
        printf '%s│%s [07] DEV          %s│%s [08] BUILD        %s│%s [09] STORAGE      %s│%s\n' "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$RESET"
        printf '%s├────────────────────┼────────────────────┼────────────────────┤%s\n' "$BRIGHT_BLACK" "$RESET"
        printf '%s│%s [10] SEARCH       %s│%s [11] MONITOR       %s│%s [12] UTILITIES    %s│%s\n' "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$RESET"
        printf '%s├────────────────────┼────────────────────┼────────────────────┤%s\n' "$BRIGHT_BLACK" "$RESET"
        printf '%s│%s [13] SETTINGS     %s│%s [14] ENVIRONMENT   %s│%s [15] EXIT          %s│%s\n' "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$BRIGHT_CYAN" "$BRIGHT_BLACK" "$RESET"
        printf '%s└────────────────────┴────────────────────┴────────────────────┘%s\n' "$BRIGHT_BLACK" "$RESET"

        printf '\n%sQuick Commands%s\n' "$BOLD" "$RESET"
        printf '  shayeen system info\n'
        printf '  shayeen crypto hash file.txt\n'
        printf '  shayeen download <URL>\n'
        printf '  shayeen dev detect\n'
        printf '  shayeen build\n'

        printf '\n%sEnvironment: %s%s\n\n' "$DIM" "$(environment_name)" "$RESET"

        prompt
        read -r choice

        case "$choice" in
            1) show_system_menu ;;
            2) show_network_menu ;;
            3) show_security_menu ;;
            4) show_crypto_menu ;;
            5) read -rp "URL: " u; download_file "$u"; pause ;;
            6) show_files_menu ;;
            7) dev_detect; pause ;;
            8) build_project; pause ;;
            9) storage_status; pause ;;
            10) read -rp "Search text: " p; search_text "$p"; pause ;;
            11) monitor_all; pause ;;
            12) utils_timestamp; printf '\n'; utils_uuid; pause ;;
            13) settings_paths; settings_theme; settings_language; pause ;;
            14) system_environment; pause ;;
            15|q|Q|0) return ;;
            *) warn "Invalid option."; pause ;;
        esac
    done
}

case "${1:-}" in

    system)
        case "${2:-info}" in
            info) system_info ;;
            cpu) system_cpu ;;
            memory) system_memory ;;
            storage) system_storage ;;
            processes) system_processes ;;
            packages) system_packages ;;
            environment) system_environment ;;
            diagnose) system_diagnose ;;
            *) err "Unknown system command." ;;
        esac
        ;;

    network)
        case "${2:-diagnostics}" in
            interfaces) network_interfaces ;;
            routes) network_routes ;;
            dns) network_dns ;;
            connectivity) network_connectivity ;;
            public-ip) network_public_ip ;;
            ports) network_ports ;;
            diagnostics) network_diagnostics ;;
            *) err "Unknown network command." ;;
        esac
        ;;

    security)
        case "${2:-audit}" in
            audit) security_audit ;;
            permissions) security_permissions "${3:-$HOME}" ;;
            hashes) security_hashes "${3:-}" ;;
            certificates) security_certificates ;;
            files) security_files ;;
            environment) security_environment ;;
            report) security_report ;;
            *) err "Unknown security command." ;;
        esac
        ;;

    crypto)
        case "${2:-hash}" in
            hash) crypto_hash "$3" ;;
            sha256) crypto_sha256 "$3" ;;
            sha512) crypto_sha512 "$3" ;;
            checksum) crypto_checksum "$3" ;;
            encrypt) crypto_encrypt "$3" "$4" ;;
            decrypt) crypto_decrypt "$3" "$4" ;;
            keygen) crypto_keygen "$3" ;;
            sign) crypto_sign "$3" ;;
            verify) crypto_verify "$3" "$4" ;;
            *) err "Unknown crypto command." ;;
        esac
        ;;

    download)
        case "${2:-file}" in
            file|url) download_file "$3" ;;
            checksum) download_checksum "$3" ;;
            resume) download_resume "$3" ;;
            extract) download_extract "$3" "$4" ;;
            *) err "Unknown download command." ;;
        esac
        ;;

    files)
        case "${2:-search}" in
            search) files_search "$3" "${4:-$HOME}" ;;
            copy) files_copy "$3" "$4" ;;
            move) files_move "$3" "$4" ;;
            rename) files_rename "$3" "$4" ;;
            delete) files_delete "$3" ;;
            compress) files_compress "$3" "$4" ;;
            extract) files_extract "$3" "$4" ;;
            checksum) files_checksum "$3" ;;
            permissions) files_permissions "$3" ;;
            *) err "Unknown files command." ;;
        esac
        ;;

    search)
        case "${2:-files}" in
            files) search_files "$3" "${4:-$HOME}" ;;
            text) search_text "$3" "${4:-$HOME}" ;;
            *) err "Unknown search command." ;;
        esac
        ;;

    monitor)
        case "${2:-all}" in
            all) monitor_all ;;
            processes) monitor_processes ;;
            memory) monitor_memory ;;
            storage) monitor_storage ;;
            network) monitor_network ;;
            *) err "Unknown monitor command." ;;
        esac
        ;;

    dev|developer)
        case "${2:-detect}" in
            detect) dev_detect ;;
            python) dev_python ;;
            node) dev_node ;;
            go) dev_go ;;
            rust) dev_rust ;;
            java) dev_java ;;
            git) dev_git ;;
            environment) dev_environment ;;
            *) err "Unknown developer command." ;;
        esac
        ;;

    build)
        build_project
        ;;

    storage)
        case "${2:-status}" in
            setup) storage_setup ;;
            status) storage_status ;;
            shared) storage_shared ;;
            permissions) storage_permissions ;;
            scan) storage_scan ;;
            backup) storage_backup "$3" ;;
            *) err "Unknown storage command." ;;
        esac
        ;;

    utils|utilities)
        case "${2:-timestamp}" in
            json) utils_json ;;
            base64) utils_base64 "$3" ;;
            timestamp) utils_timestamp ;;
            uuid) utils_uuid ;;
            calculator) utils_calculator "$3" ;;
            random) utils_random ;;
            qr) utils_qr "$3" ;;
            archive) utils_archive "$3" "$4" ;;
            *) err "Unknown utility command." ;;
        esac
        ;;

    settings)
        case "${2:-paths}" in
            theme) settings_theme ;;
            language) settings_language ;;
            editor) settings_editor ;;
            paths) settings_paths ;;
            logs) settings_logs ;;
            update) settings_update ;;
            *) err "Unknown settings command." ;;
        esac
        ;;

    --version|-v)
        printf '%s\n' "$SHAYEN_NAME $SHAYEN_VERSION"
        printf '%s\n' "$SHAYEN_TITLE"
        ;;

    --help|-h)
        cat <<HELP

SHΛYEN TOOLKIT
THE SILENT SOVEREIGN
Version $SHAYEN_VERSION

KNOW • BUILD • PROTECT
SYN-94

Usage:
  shayeen
  sn

Direct commands:
  shayeen system info
  shayeen network diagnostics
  shayeen security audit
  shayeen crypto hash file.txt
  shayeen download <URL>
  shayeen files search <pattern>
  shayeen dev detect
  shayeen build
  shayeen storage status
  shayeen settings paths

Prompt:
  ⟦SN-🜏⟧ ~/shaheen $

Platform:
  Termux / Android / Linux / PRoot environments

HELP
        ;;

    "")
        show_dashboard
        ;;

    *)
        err "Unknown command: $1"
        printf 'Use: shayeen --help\n'
        exit 1
        ;;
esac

shayeen_log "$*"
